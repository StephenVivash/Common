<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);MUSE_PROTOCOL_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Muse/*.cs" Exclude="../Muse/MuseBtClient.cs" Link="Muse/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
