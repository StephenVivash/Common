<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProtocolSource Condition="'$(ProtocolSource)' == ''">$(MSBuildThisFileDirectory)..\..\WattCycle</ProtocolSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProtocolSource)\TdtProtocol.cs" Link="TdtProtocol.cs" />
    <Compile Include="$(ProtocolSource)\GattSessionOperations.cs" Link="GattSessionOperations.cs" />
    <Compile Include="$(ProtocolSource)\BluetoothReadAttempt.cs" Link="BluetoothReadAttempt.cs" />
    <Compile Include="..\..\WattCycle\TdtFrameReader.cs" Link="TdtFrameReader.cs" />
    <Compile Include="..\..\WattCycle\WattCycleModels.cs" Link="WattCycleModels.cs" />
  </ItemGroup>
</Project>
